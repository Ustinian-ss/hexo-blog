// ============================================================
// Archive 鈥?rewritten with CSS custom properties
// ============================================================
.archives-wrap
  margin: block-margin 0

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1em

.archive-year
  @extend $block-caption
  font-size: 15px
  text-decoration: none

.archives
  column-gap: 10px
  @media mq-tablet
    column-count: 2
  @media mq-normal
    column-count: 3

.archive-article
  avoid-column-break()

.archive-article-inner
  @extend $block
  padding: 16px
  margin-bottom: 15px

.archive-article-title
  text-decoration: none
  font-weight: 700
  color: var(--text-primary)
  transition: color var(--transition-fast)
  line-height: line-height
  &:hover
    color: var(--accent)

.archive-article-footer
  margin-top: 1em

.archive-article-date
  color: var(--text-muted)
  text-decoration: none
  font-size: 0.85em
  line-height: 1em
  margin-bottom: 0.5em
  display: block

// Pagination uses #page-nav from _extend.styl
