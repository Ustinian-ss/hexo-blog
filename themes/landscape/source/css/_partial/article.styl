// ============================================================
// Article 鈥?rewritten with CSS custom properties
// ============================================================
.article
  margin: block-margin 0

.article-inner
  @extend $block
  overflow: hidden

.article-meta
  clearfix()
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 10px

.article-date
  @extend $block-caption

.article-category
  line-height: 1em
  color: var(--text-muted)
  &:before
    content: "\2022"
    margin-right: 6px

.article-category-link
  @extend $block-caption
  margin: 0

.article-header
  padding: article-padding article-padding 0

.article-title
  text-decoration: none
  font-size: clamp(22px, 3.4vw, 32px)
  font-weight: 800
  letter-spacing: -.02em
  color: var(--text-primary)
  line-height: line-height-title
  transition: color var(--transition-fast)
  a
    color: inherit
    text-decoration: none

.article-entry
  @extend $base-style
  clearfix()
  color: var(--text-primary)
  padding: 0 article-padding
  line-height: 1.88
  p, table
    line-height: line-height
    margin: line-height 0
  h1, h2, h3, h4, h5, h6
    font-weight: bold
    color: var(--text-primary)
    margin-top: 1.6em
    margin-bottom: .6em
  h1, h2, h3, h4, h5, h6
    line-height: line-height-title
  a
    color: var(--accent)
    text-decoration: none
    border-bottom: 1px solid var(--accent-border)
    transition: border-color var(--transition-fast)
    &:hover
      border-bottom-color: var(--accent)
  ul, ol, dl
    margin-top: line-height
    margin-bottom: line-height
  img, video
    max-width: 100%
    height: auto
    display: block
    margin: auto
    border-radius: var(--radius-sm)
  iframe
    border: none
  table
    width: 100%
    border-collapse: separate
    border-spacing: 0
    margin: 1.6em 0
    font-size: .94em
    border-radius: var(--radius-md)
    overflow: hidden
    border: 1px solid var(--table-border)
    box-shadow: var(--shadow-sm)
  th
    font-weight: 700
    background: var(--bg-elevated)
    color: var(--text-primary)
    padding: 12px 16px
    text-align: left
    border-bottom: 2px solid var(--border)
    font-size: .92em
  td
    padding: 10px 16px
    border-bottom: 1px solid var(--table-border)
    color: var(--text-primary)
  tr:last-child td
    border-bottom: none
  tr:nth-child(even) td
    background: var(--table-stripe)
  blockquote
    margin: 1.5em 0
    padding: 16px 22px
    border-left: 4px solid var(--accent)
    background: var(--accent-bg)
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0
    color: var(--text-secondary)
    p
      margin: 0
    footer
      font-size: font-size
      margin: line-height 0
      font-family: font-sans
      cite
        &:before
          content: "—"
          padding: 0 0.5em
  .pullquote
    text-align: left
    width: 45%
    margin: 0
    &.left
      margin-left: 0.5em
      margin-right: 1em
    &.right
      margin-right: 0.5em
      margin-left: 1em
  .caption
    color: var(--text-muted)
    display: block
    font-size: 0.9em
    margin-top: 0.5em
    position: relative
    text-align: center
  .video-container
    position: relative
    padding-top: (9 / 16 * 100)%
    height: 0
    overflow: hidden
    iframe, object, embed
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      margin-top: 0

.article-more-link a
  display: inline-flex
  align-items: center
  gap: 6px
  padding: 10px 20px
  border-radius: var(--radius-full)
  background: var(--accent-bg)
  color: var(--accent)
  text-decoration: none
  font-weight: 600
  font-size: 14px
  border: 1px solid var(--accent-border)
  transition: all var(--transition-fast)
  &:hover
    background: var(--accent)
    color: #fff
    transform: translateY(-1px)

.article-footer
  clearfix()
  display: flex
  flex-wrap: wrap
  gap: 8px
  align-items: center
  font-size: 0.85em
  line-height: line-height
  border-top: 1px solid var(--border)
  padding-top: 18px
  margin: 18px article-padding article-padding
  a
    color: var(--text-secondary)
    text-decoration: none
    transition: color var(--transition-fast)
    &:hover
      color: var(--accent)

.article-tag-list-item
  float: left
  margin-right: 10px

.article-tag-list-link
  display: inline-block
  padding: 3px 10px
  border-radius: var(--radius-full)
  background: var(--accent-bg)
  color: var(--accent) !important
  font-size: 12px
  font-weight: 600
  border: 1px solid var(--accent-border)
  transition: all var(--transition-fast)
  &:before
    content: '\000023'; margin-right: 2px
  &:hover
    background: var(--accent)
    color: #fff !important

.article-comment-link
  float: right
  &:before
    padding-right: 8px

.article-share-link
  cursor: pointer
  float: right
  margin-left: 20px
  display: inline-flex
  align-items: center
  gap: 4px
  padding: 6px 14px
  border-radius: var(--radius-full)
  background: var(--bg-elevated)
  color: var(--text-secondary)
  text-decoration: none
  border: 1px solid var(--border)
  transition: all var(--transition-fast)
  &:before
    padding-right: 6px
  &:hover
    background: var(--accent)
    color: #fff
    border-color: var(--accent)

#article-nav
  clearfix()
  position: relative
  display: flex
  gap: 16px
  margin: 32px 0
  @media (max-width: 768px)
    flex-direction: column

.article-nav-link-wrap
  flex: 1
  display: flex
  flex-direction: column
  justify-content: center
  padding: 20px 24px
  border-radius: var(--radius-lg)
  background: var(--bg-surface)
  border: 1px solid var(--border)
  text-decoration: none
  color: var(--text-secondary)
  box-shadow: var(--shadow-sm)
  transition: all var(--transition-base)
  &:hover
    border-color: var(--accent-border)
    box-shadow: var(--shadow-md)
    color: var(--accent)
    transform: translateY(-2px)

#article-nav-newer
  text-align: left
  align-items: flex-start

#article-nav-older
  text-align: right
  align-items: flex-end

.article-nav-caption
  text-transform: uppercase
  letter-spacing: 2px
  color: var(--text-muted)
  line-height: 1em
  font-weight: 700
  font-size: 11px
  margin-bottom: 8px

.article-nav-title
  font-size: 15px
  font-weight: 600
  line-height: 1.4
  color: var(--text-primary)

.article-share-box
  position: absolute
  display: none
  background: var(--bg-surface)
  box-shadow: var(--shadow-lg)
  border: 1px solid var(--border)
  border-radius: var(--radius-md)
  margin-left: -145px
  overflow: hidden
  z-index: 1
  &.on
    display: block

.article-share-input
  width: 100%
  background: none
  box-sizing: border-box
  font: 14px font-sans
  padding: 0 15px
  color: var(--text-primary)
  outline: none
  border: 1px solid var(--border)
  border-radius: var(--radius-md) var(--radius-md) 0 0
  height: 36px
  line-height: 36px

.article-share-links
  clearfix()
  background: var(--bg-elevated)
  display: flex

$article-share-link
  width: 50px
  height: 36px
  display: flex
  align-items: center
  justify-content: center
  position: relative
  color: var(--text-secondary)
  transition: all var(--transition-fast)
  &:hover
    color: #fff

.article-share-twitter
  @extend $article-share-link
  &:hover
    background: color-twitter

.article-share-facebook
  @extend $article-share-link
  &:hover
    background: color-facebook

.article-share-pinterest
  @extend $article-share-link
  &:hover
    background: color-pinterest

.article-share-linkedin
  @extend $article-share-link
  &:hover
    background: color-linkedin

.article-gallery
  background: #000
  position: relative

.article-gallery-photos
  position: relative
  overflow: hidden

.article-gallery-img
  display: none
  max-width: 100%
  &:first-child
    display: block
  &.loaded
    position: absolute
    display: block
  img
    display: block
    max-width: 100%
    margin: 0 auto
